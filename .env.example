# Copy to .env and fill in the values. The .env file is gitignored.

# Required for live evals. CI sets this from the GEMINI_API_KEY secret.
GEMINI_API_KEY=

# --- Optional role overrides ---
# Uncomment to point the candidate or judge at a local proxy (for example CLIProxyAPI)
# or to use a different model than the extension defaults.
# EVAL_TRANSLATION_API_KEY=
# EVAL_TRANSLATION_API_BASE_URL=http://127.0.0.1:8317
# EVAL_TRANSLATION_MODEL=gemini-3.5-flash
#
# EVAL_JUDGE_API_KEY=
# EVAL_JUDGE_API_BASE_URL=http://127.0.0.1:8317
# EVAL_JUDGE_PROVIDER_ID=google:gemini-3-flash-preview

# --- Optional: promptfoo runtime knobs ---
# PROMPTFOO_EVAL_TIMEOUT_MS=60000
# PROMPTFOO_FAILED_TEST_EXIT_CODE=100
# PROMPTFOO_DISABLE_TELEMETRY=true
# PROMPTFOO_LOG_DIR=./evals/results/logs
