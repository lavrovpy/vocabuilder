# Copy to .env and fill in the values. The .env file is gitignored.
# `npm run eval -- --model <route>[/<model>] --judge <route>/<model>` reads the
# variables for the routes it is given; see the Evals section of AGENTS.md.

# --- Candidate and judge keys (one per key-based route) ---
# CI sets GEMINI_API_KEY from a repository secret; its default judge runs on it.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# --- --model openai-compatible/<model> ---
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1

# --- Optional candidate server overrides (a local proxy, for example) ---
# GEMINI_BASE_URL=http://127.0.0.1:8317
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=

# --- Optional judge overrides for key-based judge routes ---
# A separate key for the judge when it shares a route with a candidate.
# EVAL_JUDGE_API_KEY=
# EVAL_JUDGE_API_BASE_URL=http://127.0.0.1:8317

# --- --judge vertex/<model>: sign in with `gcloud auth application-default login` ---
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

# --- --judge bedrock/<model-id>: sign in with your AWS profile or `aws sso login` ---
# Promptfoo reads the region from this variable only, not AWS_REGION.
# AWS_BEDROCK_REGION=us-east-1

# --- Optional: promptfoo runtime knobs ---
# PROMPTFOO_EVAL_TIMEOUT_MS=60000
# PROMPTFOO_FAILED_TEST_EXIT_CODE=100
# PROMPTFOO_DISABLE_TELEMETRY=true
# PROMPTFOO_LOG_DIR=./evals/results/logs
