# Copy to .env and fill in the values. The .env file is gitignored.

# Required for live evals. CI sets this from the GEMINI_API_KEY secret; the
# gemini eval provider and the Gemini rubric judge both use it by default.
GEMINI_API_KEY=

# --- Optional: keys for the other eval providers ---
# Only needed for `npm run eval:providers`, which adds the Anthropic and OpenAI entries.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Not in the default suite; add a `provider: openai-compatible` entry (with a
# `model`) to promptfooconfig.yaml to evaluate a compatible server.
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1

# --- Optional role and endpoint overrides ---
# EVAL_TRANSLATION_* applies to the Gemini candidate. Vendor-specific URL/model
# settings take precedence. See docs/evaluations.md for commands and result review.
# EVAL_TRANSLATION_API_KEY=
# EVAL_TRANSLATION_API_BASE_URL=http://127.0.0.1:8317
# EVAL_TRANSLATION_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
#
# Judge settings affect only the judge, including when its vendor is also a
# candidate. Set key, URL, and provider ID together when switching vendor or proxy.
# EVAL_JUDGE_API_KEY=
# EVAL_JUDGE_API_BASE_URL=http://127.0.0.1:8317
# EVAL_JUDGE_PROVIDER_ID=google:gemini-3-flash-preview

# --- Optional: promptfoo runtime knobs ---
# PROMPTFOO_EVAL_TIMEOUT_MS=60000
# PROMPTFOO_FAILED_TEST_EXIT_CODE=100
# PROMPTFOO_DISABLE_TELEMETRY=true
# PROMPTFOO_LOG_DIR=./evals/results/logs
