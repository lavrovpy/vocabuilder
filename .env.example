# Copy to .env and fill in the values. The .env file is gitignored.

# --- Translation evaluation target ---
# For CLIProxyAPI, use a client key from its api-keys configuration.
EVAL_TRANSLATION_API_KEY=
EVAL_TRANSLATION_API_BASE_URL=http://127.0.0.1:8317
EVAL_TRANSLATION_MODEL=gemini-3.5-flash-extra-low

# --- Semantic judge ---
# The provider ID is Promptfoo's complete provider identifier, including model.
# Examples: google:gemini-3.1-pro-low or openai:responses:gpt-5
# Key-based google, openai, and anthropic provider prefixes are supported.
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_API_BASE_URL=http://127.0.0.1:8317
EVAL_JUDGE_PROVIDER_ID=google:gemini-3.1-pro-low

# --- Optional: promptfoo runtime knobs ---
# PROMPTFOO_EVAL_TIMEOUT_MS=60000
# PROMPTFOO_FAILED_TEST_EXIT_CODE=100
# PROMPTFOO_DISABLE_TELEMETRY=true
# PROMPTFOO_LOG_DIR=./evals/results/logs
